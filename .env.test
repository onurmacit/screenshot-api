# =============================================================================
# Screenshot API - Test Environment Variables
# =============================================================================

APP_NAME=ScreenshotAPI
APP_VERSION=1.0.0
APP_ENV=test
DEBUG=true
LOG_LEVEL=DEBUG

HOST=0.0.0.0
PORT=8000
WORKERS=1

SECRET_KEY=test-secret-key-for-testing-only
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/screenshot_api_test
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5

REDIS_URL=redis://localhost:6379/10
REDIS_CACHE_DB=11
REDIS_RATE_LIMIT_DB=12

CELERY_BROKER_URL=redis://localhost:6379/10
CELERY_RESULT_BACKEND=redis://localhost:6379/11

AWS_ACCESS_KEY_ID=test-access-key
AWS_SECRET_ACCESS_KEY=test-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=screenshot-api-test
AWS_S3_ENDPOINT_URL=http://localhost:9000

STRIPE_SECRET_KEY=sk_test_fake_key
STRIPE_WEBHOOK_SECRET=whsec_test_secret
STRIPE_PUBLISHABLE_KEY=pk_test_fake_key

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=test@screenshotapi.com
SMTP_FROM_NAME=Screenshot API Test

BROWSER_POOL_SIZE=2
BROWSER_TIMEOUT_MS=10000
BROWSER_MAX_RENDERS_PER_CONTEXT=10

RATE_LIMIT_ENABLED=false
IP_RATE_LIMIT_PER_MINUTE=1000

RENDER_EXPIRY_DAYS=1
SIGNED_URL_EXPIRY_SECONDS=300

CORS_ORIGINS=["http://localhost:3000"]


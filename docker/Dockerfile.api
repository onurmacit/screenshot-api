# =============================================================================
# Screenshot API - API Service Dockerfile
# =============================================================================
# Using Playwright base image for Chromium support

FROM mcr.microsoft.com/playwright/python:v1.57.0-noble

# Labels
LABEL maintainer="Screenshot API Team <team@screenshotapi.com>" \
      version="1.0.0" \
      description="Screenshot API - FastAPI Application with Playwright"

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONFAULTHANDLER=1 \
    APP_HOME=/app

# Set working directory
WORKDIR $APP_HOME

# Install Python dependencies
COPY requirements.txt .
RUN pip install --upgrade pip && \
    pip install -r requirements.txt

# Note: Playwright base image already includes Chromium browser
# Playwright will use its internal default path to locate browsers

# Copy application code
COPY . .

# Create necessary directories
RUN mkdir -p /app/logs

# Expose port
EXPOSE 8080

# Health check - DigitalOcean App Platform handles health checks via http_path
# HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
#     CMD curl -f http://localhost:8080/api/v1/health/live || exit 1

# Default command - DigitalOcean App Platform sets PORT env var
# This is a fallback, App Platform will use run_command from app spec
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8080}"]

# =============================================================================
# Screenshot API - Secrets (Example)
# =============================================================================
# Copy this file to secret.yaml and fill in the base64-encoded values
# To encode: echo -n "your-value" | base64

apiVersion: v1
kind: Secret
metadata:
  name: screenshot-api-secrets
  namespace: screenshot-api
type: Opaque
data:
  # Application
  SECRET_KEY: <base64-encoded-secret-key>
  
  # Database
  DATABASE_URL: <base64-encoded-database-url>
  
  # Redis
  REDIS_URL: <base64-encoded-redis-url>
  CELERY_BROKER_URL: <base64-encoded-celery-broker-url>
  CELERY_RESULT_BACKEND: <base64-encoded-celery-result-backend>
  
  # AWS S3
  AWS_ACCESS_KEY_ID: <base64-encoded-aws-access-key>
  AWS_SECRET_ACCESS_KEY: <base64-encoded-aws-secret-key>
  AWS_S3_BUCKET: <base64-encoded-bucket-name>
  
  # Stripe
  STRIPE_SECRET_KEY: <base64-encoded-stripe-secret-key>
  STRIPE_WEBHOOK_SECRET: <base64-encoded-stripe-webhook-secret>
  
  # Sentry (optional)
  SENTRY_DSN: <base64-encoded-sentry-dsn>

